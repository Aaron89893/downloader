{
  "manifest_version": 3,
  "name": "downloader",
  "version": "1.0.0",
  "description": "Tải video TikTok, Douyin, YouTube, Bilibili chất lượng cao kèm phụ đề gốc.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "cookies",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
